{
  "redirects": [
    {
      "source": "/(https:)/:path*",
      "destination": "https://:path*",
      "permanent": false
    },
    {
      "source": "/(http:)/:path*",
      "destination": "http://:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://reeferon-crm-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://reeferon-crm-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}